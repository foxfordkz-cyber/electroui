<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.ElectroUi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorTertiary">@color/warning</item>
        <item name="materialCardViewStyle">@style/Widget.ElectroUi.Card</item>
        <item name="textInputStyle">@style/Widget.ElectroUi.Input</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.ElectroUi.BottomSheet</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ElectroUi.Blue" parent="Base.ElectroUi">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryContainer">@color/blue_container</item>
        <item name="colorOnPrimaryContainer">@color/blue_on_container</item>
        <item name="colorSecondary">@color/blue_primary</item>
        <item name="colorSecondaryContainer">@color/blue_container</item>
        <item name="colorOnSecondaryContainer">@color/blue_on_container</item>
        <item name="headerBackground">@drawable/bg_grad_blue</item>
    </style>

    <style name="Theme.ElectroUi.Green" parent="Base.ElectroUi">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/green_on_container</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorSecondaryContainer">@color/green_container</item>
        <item name="colorOnSecondaryContainer">@color/green_on_container</item>
        <item name="headerBackground">@drawable/bg_grad_green</item>
    </style>

    <style name="Theme.ElectroUi.Orange" parent="Base.ElectroUi">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryContainer">@color/orange_container</item>
        <item name="colorOnPrimaryContainer">@color/orange_on_container</item>
        <item name="colorSecondary">@color/orange_primary</item>
        <item name="colorSecondaryContainer">@color/orange_container</item>
        <item name="colorOnSecondaryContainer">@color/orange_on_container</item>
        <item name="headerBackground">@drawable/bg_grad_orange</item>
    </style>

    <style name="Theme.ElectroUi.Purple" parent="Base.ElectroUi">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryContainer">@color/purple_container</item>
        <item name="colorOnPrimaryContainer">@color/purple_on_container</item>
        <item name="colorSecondary">@color/purple_primary</item>
        <item name="colorSecondaryContainer">@color/purple_container</item>
        <item name="colorOnSecondaryContainer">@color/purple_on_container</item>
        <item name="headerBackground">@drawable/bg_grad_purple</item>
    </style>

    <style name="Theme.ElectroUi.Splash" parent="Theme.ElectroUi.Blue">
        <item name="android:windowBackground">@drawable/bg_grad_blue</item>
    </style>

    <style name="ThemeOverlay.ElectroUi.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ElectroUi.BottomSheet</item>
    </style>
    <style name="Widget.ElectroUi.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="ThemeOverlay.ElectroUi.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>
</resources>
